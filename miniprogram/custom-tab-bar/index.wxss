.dock {
  position: fixed;
  z-index: 100;
  left: 10%;
  right: 10%;
  margin: 0 auto;
  max-width: 340px;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 6rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, .96);
  border-radius: 999rpx;
  background: rgba(247, 251, 248, .88);
  background-image: linear-gradient(160deg, rgba(255,255,255,.66), rgba(227,239,231,.12) 66%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  backdrop-filter: blur(18px) saturate(150%);
  box-shadow: 0 6rpx 28rpx rgba(18, 42, 31, .12), inset 0 -1rpx 2rpx rgba(91, 121, 99, .16);
}
.dock-item {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 999rpx;
  color: #43574b;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.25;
}
.dock-icon { width: 36rpx; height: 36rpx; }
.dock-item.active { background: #086b52; color: white; }
.dock-item.pressed { opacity: .82; }
