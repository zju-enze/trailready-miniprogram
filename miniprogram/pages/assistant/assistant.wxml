<view class="trail-screen plan-screen">
  <view wx:if="{{destination}}" class="view-intro plan-intro">
    <text class="view-title">{{destination}}</text>
    <text wx:if="{{start}}" class="trail-meta">{{start}} 出发</text>
  </view>

  <view wx:if="{{loading}}" class="plan-state" role="status">
    <view class="plan-spinner" aria-hidden="true"></view>
    <text>正在规划</text>
  </view>
  <view wx:elif="{{error}}" class="plan-state plan-error">
    <text role="alert">{{error}}</text>
    <button class="trail-primary" bindtap="generate">重试</button>
  </view>
  <block wx:elif="{{plan}}">
    <view class="trail-card">
      <view class="trail-heading"><text class="section-title">每日路线</text><text class="plan-meta">{{plan.days.length}} 天 · {{readOnly ? '原始 AI 方案' : 'AI 草稿'}}</text></view>
      <view class="itinerary">
        <view wx:for="{{plan.days}}" wx:key="dayIndex" class="plan-day {{index === dayIndex ? 'selected-day' : ''}}">
          <button wx:if="{{plan.days.length > 1}}" class="day-select" data-index="{{index}}" bindtap="selectDay" aria-expanded="{{index === dayIndex}}">
            <view class="day-name"><text class="day-date">第 {{item.dayIndex}} 天 · {{item.displayDate}}</text><text class="day-route">{{item.from ? item.from + ' → ' : ''}}{{item.destination}}</text></view>
            <view class="disclosure-arrow {{index === dayIndex ? 'open' : ''}}" aria-hidden="true"></view>
          </button>
          <view wx:else class="day-name"><text class="day-date">第 {{item.dayIndex}} 天 · {{item.displayDate}}</text><text class="day-route">{{item.from ? item.from + ' → ' : ''}}{{item.destination}}</text></view>
          <block wx:if="{{index === dayIndex}}">
            <view wx:if="{{item.distance != null || item.ascent != null}}" class="stats trail-meta">
              <text wx:if="{{item.distance != null}}">约 {{item.distance}} km</text>
              <text wx:if="{{item.ascent != null}}">爬升 {{item.ascent}} m</text>
            </view>
            <text wx:if="{{item.timeText}}" class="route-time">{{item.timeText}}</text>
            <text wx:if="{{lastHike}}" class="trail-meta">{{lastHike}}</text>
            <text class="trail-meta route-check">出发前请核实步道是否开放、沿途路况</text>
            <map wx:if="{{mapView}}" id="route-map" class="route-map" latitude="{{mapView.latitude}}" longitude="{{mapView.longitude}}" scale="14"
              markers="{{mapView.markers}}" polyline="{{mapView.line}}" include-points="{{mapView.bounds}}" aria-label="第 {{item.dayIndex}} 天路线地图"/>
            <text class="map-source">{{mapView ? (mapView.line.length ? '普通步行路网' : '地点位置 · 路线待核实') : '路线地图待核实'}}</text>
            <view class="day-weather">
              <block wx:if="{{item.weather && item.weather.source === 'qweather'}}">
                <text class="day-date">和风预报{{item.weatherPlace ? ' · ' + item.weatherPlace : ''}}</text>
                <text class="weather-reading">{{item.weather.description}} {{item.weather.tempMin}}～{{item.weather.tempMax}}°C</text>
              </block>
              <text wx:else class="trail-meta">天气待核实</text>
            </view>
            <text wx:if="{{item.stay || item.stayType === 'pending'}}" class="trail-meta">住宿 · {{item.stay || '待确认'}}</text>
            <text wx:if="{{item.transport}}" class="trail-meta">接驳 · {{item.transport}}</text>
          </block>
        </view>
      </view>
    </view>
    <view wx:if="{{plan.equipment.length || plan.missing.length}}" class="trail-card packing-list">
      <view wx:if="{{plan.equipment.length}}" class="gear-group">
        <text class="section-title">从装备库选用</text>
        <view wx:for="{{plan.equipment}}" wx:key="id" class="plan-item">
          <text class="row-title">{{item.name}}</text><text class="trail-meta">× {{item.quantity}}</text>
        </view>
      </view>
      <view wx:if="{{plan.missing.length}}" class="gear-group">
        <text class="section-title">建议补充</text>
        <view wx:for="{{plan.missing}}" wx:key="name" class="plan-item">
          <view class="row-main"><text class="row-title">{{item.name}}</text><text wx:if="{{item.reason}}" class="trail-meta">{{item.reason}}</text></view>
          <text wx:if="{{item.quantity > 1}}" class="trail-meta">× {{item.quantity}}</text>
        </view>
      </view>
    </view>
    <view class="plan-details">
      <button class="details-toggle" bindtap="toggleDetails" aria-expanded="{{detailsOpen}}">
        <text>规划依据与待核实项</text><view class="disclosure-arrow {{detailsOpen ? 'open' : ''}}" aria-hidden="true"></view>
      </button>
      <view wx:if="{{detailsOpen}}" class="details-body">
        <text wx:if="{{address}}" class="trail-meta">{{address}}</text>
        <text wx:if="{{plan.summary}}" class="trail-note">{{plan.summary}}</text>
        <block wx:for="{{plan.equipment}}" wx:key="id"><text wx:if="{{item.reason}}" class="trail-note">{{item.name}} · {{item.reason}}</text></block>
        <text wx:for="{{plan.notes}}" wx:key="*this" class="trail-note">{{item}}</text>
      </view>
    </view>
    <button wx:if="{{!saved && !readOnly}}" class="trail-primary" bindtap="adopt">采用并新建行程</button>
    <button wx:elif="{{saved}}" class="trail-primary" bindtap="openTrip">查看行程</button>
  </block>
  <navigator wx:else open-type="switchTab" url="/pages/overview/overview" class="trail-link">{{readOnly ? '返回行程' : '选择目的地'}}</navigator>
</view>
