.plan-screen { gap: 24rpx; }
.plan-intro { padding: 14rpx 0 8rpx; }
.plan-meta, .day-date { color: #426555; font-size: 24rpx; }
.plan-state { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; color: #52665a; font-size: 30rpx; }
.plan-error { align-items: stretch; flex-direction: column; gap: 32rpx; }
.plan-spinner { width: 27rpx; height: 27rpx; border: 3rpx solid #c8d7ce; border-top-color: #086b52; border-radius: 50%; animation: plan-turn .9s linear infinite; }
@keyframes plan-turn { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .plan-spinner { animation: none; } }
.itinerary { margin-top: 20rpx; }
.plan-day { position: relative; margin-left: 6rpx; padding: 0 0 26rpx 28rpx; border-left: 2rpx solid #dbe6df; display: flex; flex-direction: column; gap: 5rpx; }
.plan-day::before { content: ""; position: absolute; left: -8rpx; top: 11rpx; width: 10rpx; height: 10rpx; background: #fff; border: 2rpx solid #086b52; border-radius: 50%; }
.plan-day:last-child { border-color: transparent; padding-bottom: 0; }
.day-route { color: #16231d; font-size: 31rpx; font-weight: 600; }
.day-name { display: flex; flex-direction: column; min-width: 0; }
.plan-screen .day-select { width: 100%; min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.selected-day::before { background: #086b52; }
.route-map { width: 100%; height: 340rpx; display: block; margin-top: 12rpx; border-radius: 16rpx; overflow: hidden; }
.map-source { font-size: 24rpx; line-height: 1.5; color: #52665a; }
.day-weather { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6rpx 14rpx; margin: 14rpx 0 4rpx; border-top: 1rpx solid #e5e9e6; padding-top: 14rpx; }
.weather-reading { font-size: 28rpx; color: #16231d; font-weight: 600; }
.stats { display: flex; flex-wrap: wrap; column-gap: 16rpx; }
.gear-group + .gear-group { margin-top: 30rpx; }
.plan-item { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid #e5e9e6; }
.plan-item:last-child { padding-bottom: 0; border: 0; }
.plan-item .trail-meta, .plan-item .plan-meta { flex: none; }
.plan-details .details-toggle { width: 100%; display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; font-size: 28rpx; color: #426555; }
.disclosure-arrow { width: 12rpx; height: 12rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); margin-right: 8rpx; }
.disclosure-arrow.open { transform: rotate(225deg); }
.details-body .trail-note { line-height: 1.65; }
