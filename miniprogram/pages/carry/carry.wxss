.weight-panel { display: flex; flex-direction: column; gap: 6rpx; padding: 12rpx 4rpx 8rpx; }
.weight-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 18rpx; }
.weight-line .metric { font-size: 76rpx; line-height: 1.12; color: #16231d; }
.weight-line .unit { font-size: 34rpx; }
.carry-count { display: inline; font-weight: 400; }
.item-block { border-top: 1rpx solid #e5e9e6; padding: 20rpx 0; }
.item-block:last-child { padding-bottom: 0; }
.trail-controls { display: flex; justify-content: space-between; align-items: center; gap: 8rpx; margin-top: 12rpx; }
.trail-screen .placement { min-height: 44px; padding: 0 12rpx; color: #086b52; font-size: 26rpx; }
.stepper { display: flex; align-items: center; border-radius: 999rpx; background: #f3f6f4; font-size: 28rpx; font-variant-numeric: tabular-nums; }
.trail-screen .stepper button { width: 44px; min-height: 44px; color: #086b52; font-size: 32rpx; text-align: center; }
.stepper button[disabled] { opacity: .38; }
