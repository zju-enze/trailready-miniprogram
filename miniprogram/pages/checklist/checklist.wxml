<view class="trail-screen" wx:if="{{trip}}">
  <view class="check-head">
    <text class="view-title">{{trip.name}}</text>
    <view class="progress-label"><text class="trail-meta">已核对</text><text class="progress-count">{{prep.done}} / {{prep.total}}</text></view>
    <progress percent="{{prep.percent}}" activeColor="#086b52" backgroundColor="#dce5df" stroke-width="3"/>
  </view>
  <view class="trail-card">
    <view class="trail-heading">
      <text class="section-title">装备</text>
      <navigator class="trail-link" open-type="redirect" url="/pages/carry/carry?trip={{trip.id}}">{{prep.items.length ? '调整' : '选择装备'}}</navigator>
    </view>
    <button wx:for="{{prep.items}}" wx:key="id" class="trail-check {{item.packed ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleGear" aria-label="{{item.name}}，{{item.worn ? '穿着' : '装包'}}，{{item.packed ? '已核对' : '待核对'}}">
      <text class="checkmark" aria-hidden="true">{{item.packed ? '✓' : ''}}</text>
      <view class="row-main"><text class="row-title">{{item.name}}</text><text class="trail-meta">× {{item.quantity}} · {{item.worn ? '穿着' : '装包'}}</text></view>
    </button>
  </view>
  <view class="trail-card">
    <view class="trail-heading"><text class="section-title">待办</text><button class="trail-link" bindtap="addCheck">＋ 添加</button></view>
    <view class="task-line" wx:for="{{trip.checks}}" wx:key="id">
      <button class="trail-check {{item.done ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggleCheck" aria-label="{{item.text}}，{{item.done ? '已确认' : '待确认'}}">
        <text class="checkmark" aria-hidden="true">{{item.done ? '✓' : ''}}</text><text class="row-title">{{item.text}}</text>
      </button>
      <button class="trail-muted" data-id="{{item.id}}" bindtap="removeCheck" aria-label="删除{{item.text}}">移除</button>
    </view>
    <button class="trail-check {{item.done ? 'checked' : ''}}" wx:for="{{prep.logistics}}" wx:key="id" data-index="{{item.index}}" data-field="{{item.field}}" bindtap="toggleLogistics" aria-label="{{item.text}}，{{item.done ? '已确认' : '待确认'}}">
      <text class="checkmark" aria-hidden="true">{{item.done ? '✓' : ''}}</text><text class="row-title">{{item.text}}</text>
    </button>
  </view>
  <view class="feedback-action"><t-button variant="text" size="medium" open-type="feedback" aria-label="反馈行前清单">反馈</t-button></view>
</view>
