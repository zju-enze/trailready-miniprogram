.checkmark {
  flex: none; width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center;
  border: 2rpx solid #829c8e; border-radius: 50%; color: white; box-sizing: content-box;
}
.checked .checkmark { background: #16715a; border-color: #16715a; }
.checked .row-title { color: #53685c; }
.task-line { display: flex; align-items: center; gap: 12rpx; border-top: 1rpx solid #e1e9e3; }
.task-line .trail-check { flex: 1; min-width: 0; border-top: none; }
