<view class="trail-screen tab-screen">
  <block wx:if="{{!draft}}">
    <navigator class="trail-card profile-entry" url="/pages/profile/profile" aria-label="打开个人能力画像">
      <text class="section-title">个人能力画像</text><view class="row-arrow" aria-hidden="true"/>
    </navigator>
    <view wx:if="{{!records.length}}" class="collection-empty">
      <image class="collection-symbol" src="/assets/nav/history.png" mode="aspectFit" aria-hidden="true"/>
      <button class="trail-primary" bindtap="edit">记录第一次徒步</button>
    </view>
    <block wx:else>
      <view class="trail-heading">
        <text class="view-title">{{records.length}}<text class="unit"> 次徒步</text></text>
        <button class="trail-link" bindtap="edit" aria-label="记录一次徒步">＋ 记录</button>
      </view>
      <view class="trail-card record-list">
        <button wx:for="{{records}}" wx:key="id" class="record-entry" data-id="{{item.id}}" bindtap="edit">
          <view class="trail-heading">
            <view class="row-main"><text class="trail-meta">{{item.date}}{{item.effort ? ' · ' + item.effort : ''}}</text><text class="section-title">{{item.name}}</text></view>
            <view class="row-arrow" aria-hidden="true"/>
          </view>
          <view class="record-stats">
            <text wx:if="{{item.distance != null}}">{{item.distance}} km</text><text wx:if="{{item.ascent != null}}">爬升 {{item.ascent}} m</text>
            <text wx:if="{{item.hours != null}}">{{item.hours}} 小时</text><text wx:if="{{item.load != null}}">负重 {{item.load}} kg</text>
          </view>
          <text wx:if="{{item.note}}" class="record-note">{{item.note}}</text>
        </button>
      </view>
    </block>
  </block>
  <form wx:else bindsubmit="saveRecord" class="record-form">
    <view class="trail-heading">
      <text class="view-title">{{draft.id ? '编辑经历' : '记录徒步'}}</text><button class="trail-link" bindtap="cancel">取消</button>
    </view>
    <view class="trail-card">
      <label class="field-row">路线名称<input name="name" aria-label="路线名称，必填" value="{{draft.name}}" placeholder="必填" maxlength="80"/></label>
      <view class="field-row">日期<picker mode="date" value="{{draft.date}}" end="{{today}}" bindchange="changeDate" aria-label="徒步日期"><view>{{draft.date}}　›</view></picker></view>
      <label wx:for="{{metrics}}" wx:key="key" class="field-row">
        <text>{{item.label}}</text><input name="{{item.key}}" type="digit" aria-label="{{item.label}}，单位{{item.unit}}，可留空" value="{{draft[item.key] == null ? '' : draft[item.key]}}" placeholder="—"/><text class="field-unit">{{item.unit}}</text>
      </label>
      <view class="field-row">体感<picker range="{{efforts}}" value="{{effortIndex}}" bindchange="changeEffort" aria-label="徒步体感"><view>{{efforts[effortIndex]}}　›</view></picker></view>
    </view>
    <view class="trail-card"><textarea name="note" value="{{draft.note}}" maxlength="400" auto-height placeholder="备注（选填）" aria-label="徒步备注"/></view>
    <text wx:if="{{error}}" class="record-error" role="alert">{{error}}</text>
    <button class="trail-primary" form-type="submit">保存</button>
    <button wx:if="{{draft.id}}" class="trail-muted remove-record" bindtap="remove">删除经历</button>
  </form>
</view>
