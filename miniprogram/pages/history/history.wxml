<view class="trail-screen tab-screen">
  <block wx:if="{{!draft}}">
    <view wx:if="{{historyError}}" class="trail-card trail-heading">
      <text class="record-error" role="alert">{{historyError}}</text><button class="trail-link" bindtap="refresh">重新读取</button>
    </view>
    <view wx:else class="trail-heading history-head">
      <view><text class="trail-meta">已完成徒步</text><view class="hike-count">{{stats.totalHikes}}<text class="unit"> 次</text></view></view>
      <button class="trail-primary add-record" bindtap="edit">＋ 记录徒步</button>
    </view>

    <view wx:if="{{ability}}" class="trail-card ability-card">
      <view class="trail-heading ability-heading">
        <text class="section-title">日常徒步参考</text><text class="trail-meta">{{ability.label}}</text>
      </view>
      <text wx:if="{{ability.message}}" class="trail-meta">{{ability.message}}</text>
      <view wx:else class="history-stat-grid">
        <view wx:for="{{ability.rows}}" wx:key="key" class="history-stat">
          <text class="trail-meta">{{item.label}}</text><text>{{item.value}}</text>
          <text wx:if="{{abilityExpanded}}" class="trail-meta ability-detail">{{item.detail}}</text>
        </view>
      </view>
      <block wx:if="{{!ability.message || ability.counts.highEffort || ability.comparisons.length}}">
        <button class="trail-link ability-toggle" bindtap="toggleAbility" aria-expanded="{{abilityExpanded}}">
          <text>计算依据</text><view class="expansion-arrow {{abilityExpanded ? 'expanded' : ''}}" aria-hidden="true"/>
        </button>
        <block wx:if="{{abilityExpanded}}">
          <text wx:if="{{ability.counts.highEffort}}" class="trail-meta">另有 {{ability.counts.highEffort}} 条体感 4–5 级的高负担经历，仅供对照。</text>
          <text wx:for="{{ability.comparisons}}" wx:key="key" class="trail-meta">{{item.text}}</text>
          <text wx:for="{{ability.limitations}}" wx:key="*this" class="trail-meta ability-detail">{{item}}</text>
        </block>
      </block>
    </view>

    <view class="trail-card profile-card">
      <button class="profile-toggle expansion-toggle" bindtap="toggleProfile" aria-expanded="{{profileExpanded}}">
        <text class="section-title">个人能力画像</text>
        <text class="trail-meta profile-preview">{{profileError ? '读取失败' : profileSummary}}</text>
        <view class="expansion-arrow {{profileExpanded ? 'expanded' : ''}}" aria-hidden="true"/>
      </button>
      <block wx:if="{{profileExpanded}}">
        <view class="profile-detail">
          <view class="trail-heading"><text class="section-title">我的自评</text>
            <navigator wx:if="{{!profileError}}" class="trail-link" url="/pages/profile/profile" aria-label="编辑徒步自评">{{hasAssessment ? '编辑自评' : '填写自评'}}</navigator>
          </view>
          <view wx:if="{{profileError}}" class="trail-heading"><text class="record-error" role="alert">{{profileError}}</text><button class="trail-link" bindtap="refresh">重试</button></view>
          <view wx:elif="{{hasAssessment}}" class="history-stat-grid">
            <block wx:for="{{selfRows}}" wx:key="key"><view wx:if="{{item.value !== '尚未填写'}}" class="history-stat">
              <text class="trail-meta">{{item.label}}</text><text>{{item.value}}</text>
            </view></block>
          </view>
        </view>
        <view wx:if="{{stats && stats.totalHikes}}" class="profile-detail">
          <text class="section-title">历史最高记录</text>
          <view class="history-stat-grid">
            <view wx:for="{{statRows}}" wx:key="key" class="history-stat">
              <text class="trail-meta">{{item.label}}</text><text>{{item.value === '暂无记录' ? '—' : item.value}}</text>
            </view>
          </view>
          <button wx:if="{{recentLoads.length}}" class="trail-link load-toggle" bindtap="toggleLoads" aria-expanded="{{showLoads}}">
            近期负重<view class="expansion-arrow {{showLoads ? 'expanded' : ''}}" aria-hidden="true"/>
          </button>
          <view wx:for="{{showLoads ? recentLoads : []}}" wx:key="key" class="history-load">
            <view class="row-main"><text>{{item.name}}</text><text class="trail-meta">{{item.date}}</text></view>
            <text>{{item.loadKg}} kg</text>
          </view>
        </view>
      </block>
    </view>

    <block wx:if="{{records.length}}">
      <text class="section-title history-section">{{historyExpanded ? '全部记录' : '最近记录'}}</text>
      <text wx:if="{{statsNotice}}" class="trail-meta">{{statsNotice}}</text>
      <view class="trail-card record-list">
        <button wx:for="{{historyExpanded ? records : recentRecords}}" wx:key="index" class="record-entry" data-index="{{item.index}}" bindtap="edit" aria-label="编辑{{item.name || '未命名徒步'}}">
          <view class="trail-heading">
            <view class="row-main"><text class="section-title">{{item.name || '未命名徒步'}}</text><text class="trail-meta">{{item.date || '日期待补'}}{{item.effort ? ' · ' + item.effort : ''}}</text></view>
            <view class="row-arrow" aria-hidden="true"/>
          </view>
          <view class="record-stats">
            <text wx:if="{{item.distance != null}}">{{item.distance}} km</text><text wx:if="{{item.ascent != null}}">爬升 {{item.ascent}} m</text>
            <text wx:if="{{item.hours != null}}">{{item.hours}} 小时</text><text wx:if="{{item.load != null}}">负重 {{item.load}} kg</text>
            <text wx:if="{{item.needsReview}}" class="record-review">待补全</text>
          </view>
          <text wx:if="{{item.note}}" class="record-note">{{item.note}}</text>
        </button>
        <button wx:if="{{records.length > recentRecords.length}}" class="history-toggle expansion-toggle" bindtap="toggleHistory" aria-expanded="{{historyExpanded}}">
          <text>{{historyExpanded ? '收起' : '查看全部 ' + records.length + ' 条'}}</text><view class="expansion-arrow {{historyExpanded ? 'expanded' : ''}}" aria-hidden="true"/>
        </button>
      </view>
    </block>
  </block>
  <form wx:else bindsubmit="saveRecord" class="record-form">
    <view class="trail-heading">
      <text class="view-title">{{existing ? '编辑经历' : '记录徒步'}}</text><button class="trail-link" bindtap="cancel">取消</button>
    </view>
    <view class="trail-card">
      <label class="field-row">路线名称<input name="name" aria-label="路线名称，必填" value="{{draft.name}}" placeholder="必填" maxlength="80"/></label>
      <text wx:if="{{fields.name}}" class="record-error" role="alert">{{fields.name}}</text>
      <view class="field-row">日期<picker mode="date" value="{{pickerDate}}" end="{{today}}" bindchange="changeDate" aria-label="徒步日期"><view>{{draft.date || '请选择'}}　›</view></picker></view>
      <text wx:if="{{fields.date}}" class="record-error" role="alert">{{fields.date}}</text>
      <view wx:for="{{metrics}}" wx:key="key" class="history-field">
        <label class="field-row">
          <text>{{item.label}}</text><input name="{{item.key}}" type="digit" aria-label="{{item.label}}，单位{{item.unit}}，{{item.required ? '必填' : '可留空'}}" value="{{draft[item.key]}}" placeholder="{{item.required ? '必填' : '可留空'}}"/><text class="field-unit">{{item.unit}}</text>
        </label>
        <text wx:if="{{fields[item.key]}}" class="record-error" role="alert">{{fields[item.key]}}</text>
      </view>
      <view class="field-row">体感<picker range="{{efforts}}" value="{{effortIndex}}" bindchange="changeEffort" aria-label="五级徒步体感"><view>{{efforts[effortIndex]}}　›</view></picker></view>
      <text wx:if="{{legacyEffort}}" class="trail-meta">原体感：{{legacyEffort}}</text>
      <text wx:if="{{fields.effortLevel}}" class="record-error" role="alert">{{fields.effortLevel}}</text>
    </view>
    <view class="trail-card"><textarea name="note" value="{{draft.note}}" maxlength="400" auto-height placeholder="备注（选填）" aria-label="徒步备注"/></view>
    <text wx:if="{{error}}" class="record-error" role="alert">{{error}}</text>
    <button class="trail-primary" form-type="submit">保存</button>
    <button wx:if="{{existing}}" class="trail-muted remove-record" bindtap="remove">删除经历</button>
  </form>
</view>
