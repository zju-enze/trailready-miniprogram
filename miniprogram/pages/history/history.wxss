.trail-screen .record-list { padding-top: 0; padding-bottom: 0; }
.ability-card { display: flex; flex-direction: column; gap: 12rpx; }
.ability-card .ability-heading { flex-wrap: wrap; row-gap: 4rpx; }
.ability-card .history-stat-grid { margin-top: 0; }
.ability-card .ability-detail { font-size: 24rpx; }
.ability-note { color: #8b552b; }
.trail-screen .profile-card { padding: 0; }
.trail-screen .expansion-toggle {
  display: flex; width: 100%; align-items: center; gap: 16rpx; min-height: 48px;
}
.trail-screen .profile-toggle { justify-content: space-between; padding: 20rpx 28rpx; }
.profile-detail { padding: 24rpx 28rpx; border-top: 1rpx solid #e5e9e6; }
.trail-screen .history-toggle {
  justify-content: center; border-top: 1rpx solid #e5e9e6; color: #086b52; font-size: 27rpx;
}
.expansion-arrow {
  flex: none; width: 12rpx; height: 12rpx; margin-right: 4rpx;
  border: solid currentColor; border-width: 0 2rpx 2rpx 0; transform: rotate(45deg);
}
.expansion-arrow.expanded { transform: rotate(225deg); }
.history-stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx 20rpx; margin-top: 16rpx; }
.history-stat { display: flex; flex-direction: column; gap: 4rpx; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.assessment-grid { margin-top: 6rpx; }
.stats-note { margin-top: 16rpx; }
.history-load { display: flex; align-items: center; gap: 18rpx; padding: 16rpx 0; border-top: 1rpx solid #e5e9e6; }
.profile-edit-link { display: flex; align-items: center; min-height: 44px; color: #086b52; font-size: 27rpx; flex-shrink: 0; }
.record-review { color: #8b552b; }
.trail-screen .record-entry { display: block; width: 100%; min-height: 48px; padding: 24rpx 0; }
.record-entry + .record-entry, .field-row + .field-row, .history-field, .history-field + .field-row { border-top: 1rpx solid #e5e9e6; }
.record-entry .section-title { overflow-wrap: anywhere; }
.row-arrow { flex: none; width: 10rpx; height: 10rpx; border: solid #728277; border-width: 2rpx 2rpx 0 0; transform: rotate(45deg); }
.record-stats { display: flex; flex-wrap: wrap; column-gap: 20rpx; color: #52665a; font-size: 26rpx; font-variant-numeric: tabular-nums; }
.record-stats text, .record-note { margin-top: 6rpx; }
.record-note { display: block; font-size: 27rpx; white-space: pre-wrap; overflow-wrap: anywhere; }
.record-form { display: flex; flex-direction: column; gap: 22rpx; font-size: 29rpx; }
.field-row { display: flex; align-items: center; min-height: 48px; gap: 14rpx; }
.field-row input, .field-row picker { flex: 1; min-width: 0; min-height: 44px; text-align: right; }
.field-row picker view { line-height: 44px; }
.field-unit { color: #52665a; font-size: 25rpx; }
.record-form textarea { width: 100%; box-sizing: border-box; min-height: 64px; }
.record-error, .trail-screen .remove-record { color: #a44534; }
.trail-screen .remove-record { align-self: center; }
