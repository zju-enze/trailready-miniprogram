<!--
  TrailReady 步履无忧 — 主页模板
  三标签页：📋 行程 | 🎒 装备 | ✅ 清单
-->
<wxs module="utils" src="./tag-utils.wxs" />
<view class="page-container theme-root {{currentTheme === 'dark' ? 'theme-dark' : 'theme-nature'}}">
  <!-- ===== 标签栏 ===== -->
  <view wx:if="{{!scoped}}" class="tab-bar">
    <view class="tab {{activeTab==='trip'?'tab-active':''}}" bindtap="switchTab" data-tab="trip">
      <text>📋 行程</text>
    </view>
    <view class="tab {{activeTab==='gear'?'tab-active':''}}" bindtap="switchTab" data-tab="gear">
      <text>🎒 装备<text class="tab-count">{{gear.length}}</text></text>
    </view>
    <view class="tab {{activeTab==='packing'?'tab-active':''}}" bindtap="switchTab" data-tab="packing">
      <text>✅ 清单<text class="tab-count" wx:if="{{result}}">{{packedCount}}/{{result.items.length}}</text></text>
    </view>
    <!-- 🎨 主题一键切换 -->
    <view class="theme-toggle-btn" bindtap="onToggleTheme">
      <text>{{currentTheme === 'dark' ? '🏔️ 山野' : '🤖 机甲'}}</text>
    </view>
  </view>

  <!-- =================================================================== -->
  <!-- 📋 行程标签页 -->
  <!-- =================================================================== -->
  <scroll-view wx:if="{{activeTab==='trip'}}" scroll-y enhanced show-scrollbar="{{false}}" class="tab-scroll">
    <view class="trail-screen trail-editor {{!scoped && currentTheme === 'dark' ? 'editor-dark' : ''}}">
      <view class="trail-card edit-card">
        <text class="section-title">行程安排</text>
        <view wx:if="{{scoped}}" class="edit-line">
          <text class="edit-label">行程名称</text>
          <input class="edit-input" aria-label="行程名称" value="{{tripName}}" bindinput="onTripNameInput" placeholder="我的行程" placeholder-class="edit-placeholder" maxlength="60"/>
        </view>
        <view class="edit-line">
          <text class="edit-label">出发日期</text>
          <picker class="edit-value" mode="date" value="{{startDate}}" bindchange="onStartDateChange" aria-label="选择出发日期">
            <view class="edit-picker"><text>{{startDate}}</text><text class="edit-chevron">›</text></view>
          </picker>
        </view>
        <view class="edit-line">
          <text class="edit-label">徒步天数</text>
          <view class="edit-duration">
            <button disabled="{{totalDays <= 1}}" bindtap="onDaysMinus" aria-label="减少一天">−</button>
            <input type="number" class="duration-input" value="{{totalDays}}" bindinput="onDaysInput" aria-label="徒步天数"/>
            <text>天</text>
            <button disabled="{{totalDays >= 30}}" bindtap="onDaysPlus" aria-label="增加一天">＋</button>
          </view>
        </view>
        <text wx:if="{{totalDays > 1}}" class="trail-meta">结束日期 · {{dayPlans[totalDays - 1].dateString}}</text>
        <text wx:if="{{dateExceedsForecast}}" class="trail-note">部分日期超出预报范围，请在临近出发时核对天气。</text>
      </view>

      <view wx:for="{{dayPlans}}" wx:key="dayIndex" class="trail-card edit-card">
        <view class="trail-heading"><text class="section-title">第 {{item.dayIndex}} 天</text><text class="trail-meta">{{item.displayDate}}</text></view>
        <view wx:if="{{scoped}}" class="edit-line">
          <text class="edit-label">起点</text>
          <input class="edit-input" aria-label="起点" value="{{item.from}}" data-index="{{index}}" data-field="from" bindinput="onDayFieldInput" placeholder="从哪里出发" placeholder-class="edit-placeholder"/>
        </view>
        <view class="edit-line">
          <text class="edit-label">目的地</text>
          <view class="edit-value dest-wrap">
            <input class="edit-input" aria-label="目的地" placeholder="输入地名或路线终点" placeholder-class="edit-placeholder"
              value="{{item.destination}}" data-index="{{index}}" bindinput="onDestinationInput" bindfocus="onDestinationFocus"/>
            <view wx:if="{{suggestions[index]}}" class="suggestions-dropdown" catchtap="noop">
              <view wx:if="{{suggestionsLoadingIndex === index}}" class="suggestions-loading">搜索中…</view>
              <view wx:elif="{{!suggestions[index].length}}" class="suggestion-no-result">未找到匹配的目的地</view>
              <block wx:else>
                <view wx:for="{{suggestions[index]}}" wx:key="id" wx:for-item="city" wx:for-index="cityIndex"
                  class="suggestion-item" catchtap="onSelectCity" data-day-index="{{index}}" data-city="{{city}}">
                  <view class="suggestion-info"><text class="suggestion-name">{{city.name}}</text><text class="suggestion-address">{{city.address}}</text></view>
                </view>
              </block>
            </view>
          </view>
        </view>
        <text wx:if="{{weatherLoadingIndex === index}}" class="trail-meta">正在查询 {{item.dateString}} 天气…</text>
        <view wx:elif="{{item.simulatedWeather}}" class="edit-forecast">
          <text>{{item.fetchedWeather ? '查询预报' : '模拟天气'}} · {{item.simulatedWeather.description}} {{item.simulatedWeather.tempRange}}</text>
          <text wx:for="{{item.simulatedWeather.conditions}}" wx:key="*this" class="status">{{item}}</text>
        </view>
        <view class="edit-line">
          <text class="edit-label">参考天气</text>
          <picker class="edit-value" range="{{weatherPresetOptions}}" range-key="label" value="{{item.weatherPresetIndex}}" bindchange="onWeatherPresetChange" data-index="{{index}}" aria-label="手动选择参考天气">
            <view class="edit-picker"><text>{{item.fetchedWeather ? '已采用预报' : weatherPresetOptions[item.weatherPresetIndex].label}}</text><text class="edit-chevron">›</text></view>
          </picker>
        </view>
        <view class="edit-line">
          <text class="edit-label">住宿方式</text>
          <view class="edit-stays">
            <button wx:if="{{scoped}}" class="{{item.stayType === 'daytrip' ? 'selected' : ''}}" data-index="{{index}}" data-type="daytrip" bindtap="onStayTypeToggle">不过夜</button>
            <button class="{{item.stayType === 'hotel' ? 'selected' : ''}}" data-index="{{index}}" data-type="hotel" bindtap="onStayTypeToggle">旅馆</button>
            <button class="{{item.stayType === 'camping' ? 'selected' : ''}}" data-index="{{index}}" data-type="camping" bindtap="onStayTypeToggle">扎营</button>
          </view>
        </view>
        <block wx:if="{{scoped}}">
          <view wx:if="{{item.stayType !== 'daytrip'}}" class="edit-line">
            <text class="edit-label">住宿安排</text>
            <input class="edit-input" aria-label="住宿安排" value="{{item.stay}}" data-index="{{index}}" data-field="stay" bindinput="onDayFieldInput" placeholder="填写营地或住宿地点" placeholder-class="edit-placeholder"/>
          </view>
          <view class="edit-line">
            <text class="edit-label">交通接驳</text>
            <input class="edit-input" aria-label="交通接驳" value="{{item.transport}}" data-index="{{index}}" data-field="transport" bindinput="onDayFieldInput" placeholder="例如：返程末班车" placeholder-class="edit-placeholder"/>
          </view>
        </block>
      </view>
      <button wx:if="{{scoped}}" class="trail-primary" bindtap="finishTripEdit">{{saveFailed ? '重试保存并返回' : '完成，返回总览'}}</button>
    </view>
  </scroll-view>

  <!-- =================================================================== -->
  <!-- 🎒 装备库标签页 -->
  <!-- =================================================================== -->
  <scroll-view wx:if="{{activeTab==='gear' && !directGearEdit}}" scroll-y enhanced show-scrollbar="{{false}}" class="tab-scroll">
    <view class="section-gap">

      <!-- 添加按钮 -->
      <navigator class="gear-add-btn" url="/pages/index/index?tab=gear&edit=new">＋ 添加装备</navigator>

      <!-- 空状态 -->
      <view wx:if="{{gear.length===0}}" class="gear-empty">
        <text class="gear-empty-icon">🎒</text>
        <text class="gear-empty-text">装备库为空</text>
        <text class="gear-empty-sub">点击上方按钮添加你的第一件装备</text>
      </view>

      <!-- 按分类分组 -->
      <block wx:for="{{gearGrouped}}" wx:key="category">
        <view class="gear-group">
          <!-- 分类标题 -->
          <view class="gear-cat-head" bindtap="onToggleCategory" data-cat="{{item.category}}">
            <text class="gear-cat-icon">{{item.icon}}</text>
            <text class="gear-cat-label">{{item.label}}</text>
            <text class="gear-cat-meta">{{item.items.length}}件 · {{item.totalWeight}}g</text>
            <text class="gear-cat-arrow">{{item.expanded ? '▴' : '▾'}}</text>
          </view>

          <!-- 装备项 -->
          <view wx:if="{{item.expanded}}" class="gear-items">
            <view wx:for="{{item.items}}" wx:key="id" wx:for-item="gi" class="gear-item">
              <view class="gear-item-info">
                <text class="gear-item-name">{{gi.name}}</text>
                <view class="gear-item-tags">
                  <text wx:for="{{gi.tags}}" wx:key="*this" wx:for-item="tag" class="tag-badge tag-{{tag}}">{{tag}}</text>
                </view>
              </view>
              <view class="gear-item-meta">
                <text class="gear-item-weight">{{gi.weight === null ? '重量待补' : gi.weight + ' g'}}</text>
                <view class="gear-item-actions">
                  <navigator class="gear-action-btn gear-action-edit" url="/pages/index/index?tab=gear&edit={{gi.id}}" aria-label="编辑{{gi.name}}">编辑</navigator>
                  <view class="gear-action-btn gear-action-del" bindtap="onDeleteGear" data-id="{{gi.id}}">
                    <text>🗑️</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 底部统计 -->
      <view wx:if="{{gear.length>0}}" class="gear-footer">
        <text>共 {{gearCount}} 件装备 · 已知重量 {{gearWeight}} g</text>
      </view>
    </view>
  </scroll-view>

  <!-- =================================================================== -->
  <!-- ✅ 打包清单标签页 -->
  <!-- =================================================================== -->
  <scroll-view wx:if="{{activeTab==='packing'}}" scroll-y enhanced show-scrollbar="{{false}}" class="tab-scroll">
    <view class="section-gap">

      <!-- 空状态：未配置目的地 -->
      <view wx:if="{{!result}}" class="packing-empty">
        <text class="packing-empty-icon">📦</text>
        <text class="packing-empty-title">暂无打包清单</text>
        <text class="packing-empty-desc">请在左侧输入正确的地点以刷新天气与清单。</text>
      </view>

      <block wx:if="{{result}}">
        <!-- 行程摘要 -->
        <view class="glass-card">
          <view class="card-head">
            <text class="card-head-icon">🗺️</text>
            <text class="card-head-label">行程摘要</text>
          </view>
          <view class="summary-row">
            <text class="summary-label">行程时间</text>
            <text class="summary-value">{{tripDateRange}}</text>
          </view>
          <view class="summary-row">
            <text class="summary-label">目的地</text>
            <text class="summary-value">{{destinationChain || '未设定'}}</text>
          </view>
          <view class="summary-row">
            <text class="summary-label">住宿模式</text>
            <text class="summary-value">{{smartLodgeHint}}</text>
          </view>
        </view>

        <!-- 智能宿营看板 -->
        <view wx:if="{{smartBoardText}}" class="smart-board">
          <text>{{smartBoardText}}</text>
        </view>

        <!-- 重量与温度仪表盘 -->
        <view class="glass-card">
          <view class="dashboard-grid">
            <view class="dash-item dash-weight">
              <text class="dash-num accent">{{totalWeightDisplay}}</text>
              <text class="dash-label">预估总重</text>
            </view>
            <view class="dash-item dash-temp">
              <text class="dash-num">{{result.climateSummary.minTemp === null ? '待核实' : result.climateSummary.minTemp + '~' + result.climateSummary.maxTemp + '°C'}}</text>
              <text class="dash-label">全程温度范围</text>
            </view>
          </view>
        </view>

        <!-- 气候挑战 -->
        <view wx:if="{{result.climateSummary.challenges.length>0}}" class="glass-card climate-card">
          <view class="card-head">
            <text class="card-head-icon">🌍</text>
            <text class="card-head-label">气候挑战</text>
          </view>
          <view wx:for="{{result.climateSummary.challenges}}" wx:key="*this" class="climate-item">
            <text>{{item}}</text>
          </view>
        </view>

        <!-- 警告 -->
        <view wx:if="{{result.warnings.length>0}}" class="warnings-card">
          <view class="card-head">
            <text class="card-head-icon">⚠️</text>
            <text class="card-head-label">注意事项</text>
          </view>
          <view wx:for="{{result.warnings}}" wx:key="*this" class="warning-item">
            <text>{{item}}</text>
          </view>
        </view>

        <!-- 提示消息 -->
        <view wx:if="{{result.infoMessages.length>0}}" class="glass-card info-card">
          <view wx:for="{{result.infoMessages}}" wx:key="*this" class="info-item">
            <text>{{item}}</text>
          </view>
        </view>

        <!-- 打包进度条 -->
        <view class="progress-wrap">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{packedPercent}}%"></view>
          </view>
          <text class="progress-text">已打包 {{packedCount}}/{{result.items.length}} 件 · {{packedWeight}}g/{{totalWeightDisplay}}（{{packedPercent}}%）</text>
        </view>

        <!-- 打包清单 —— 按分类分组 -->
        <block wx:for="{{packingGrouped}}" wx:key="category">
          <view class="pack-group">
            <view class="pack-cat-head" bindtap="onTogglePackCategory" data-cat="{{item.category}}">
              <text class="pack-cat-icon">{{item.icon}}</text>
              <text class="pack-cat-label">{{item.label}}</text>
              <text class="pack-cat-meta">{{item.packed}}/{{item.total}}件 · {{item.catWeight}}g</text>
              <text class="gear-cat-arrow">{{item.expanded ? '▴' : '▾'}}</text>
            </view>

            <view wx:if="{{item.expanded}}" class="pack-items">
              <view wx:for="{{item.items}}" wx:key="id" wx:for-item="pi" class="pack-item {{pi.packed?'pack-item-done':''}}">
                <view class="pack-check {{pi.packed?'pack-check-on':''}}" bindtap="onTogglePacked" data-id="{{pi.id}}">
                  <text wx:if="{{pi.packed}}">✓</text>
                </view>
                <view class="pack-item-info">
                  <text class="pack-item-name {{pi.packed?'strikethrough':''}}">{{pi.name}}</text>
                  <text wx:if="{{pi.quantity>1}}" class="pack-item-qty">×{{pi.quantity}}</text>
                  <text wx:if="{{pi.reason}}" class="pack-item-reason">{{pi.reason}}</text>
                </view>
                <text class="pack-item-wt">{{pi.weight === null ? '重量待补' : pi.weight * pi.quantity + ' g'}}</text>
              </view>
            </view>
          </view>
        </block>
      </block>
      <t-button block variant="outline" open-type="feedback">反馈行前清单</t-button>
    </view>
  </scroll-view>

  <scroll-view wx:if="{{directGearEdit}}" scroll-y enhanced show-scrollbar="{{false}}" class="tab-scroll">
    <view class="trail-screen trail-editor">
      <view class="trail-card edit-card">
        <text class="section-title">装备信息</text>
        <view class="edit-line">
          <text class="edit-label">名称</text>
          <input class="edit-input" aria-label="装备名称，必填" placeholder="例如：防雨外套" placeholder-class="edit-placeholder"
            value="{{formName}}" bindinput="onFormNameInput"/>
        </view>
        <view class="edit-line">
          <text class="edit-label">分类</text>
          <picker class="edit-value" aria-label="装备分类" range="{{gearCategoryOptions}}" range-key="label" value="{{formCategoryIndex}}" bindchange="onFormCategoryChange">
            <view class="edit-picker"><text>{{formCategoryLabel}}</text><text class="edit-chevron">›</text></view>
          </picker>
        </view>
        <view class="edit-line">
          <text class="edit-label">单件重量</text>
          <view class="edit-value gear-weight-field">
            <input class="edit-input" type="digit" aria-label="单件重量，单位克，可留空" placeholder="可留空" placeholder-class="edit-placeholder"
              value="{{formWeight}}" bindinput="onFormWeightInput"/>
            <text class="gear-unit">g</text>
          </view>
        </view>
      </view>
      <view class="trail-card edit-card">
        <view class="trail-heading"><text class="section-title">装备标签</text><text class="trail-meta">{{formTags.length ? '已选 ' + formTags.length + ' 项' : '可多选'}}</text></view>
        <view class="gear-tags">
          <button wx:for="{{allTags}}" wx:key="*this" wx:for-item="tag" class="gear-tag {{utils.includes(formTags,tag) ? 'selected' : ''}}"
            data-tag="{{tag}}" bindtap="onToggleTag" aria-label="{{tag}}，{{utils.includes(formTags,tag) ? '已选' : '未选'}}">{{tag}}</button>
        </view>
      </view>
      <text wx:if="{{formError}}" class="gear-error" role="alert">{{formError}}</text>
      <view class="gear-form-actions">
        <button class="gear-cancel" bindtap="cancelGearEdit">取消</button>
        <button class="trail-primary" bindtap="onSaveGear">{{editingId ? '保存修改' : '加入装备库'}}</button>
      </view>
      <button wx:if="{{editingId}}" class="gear-remove" data-id="{{editingId}}" bindtap="onDeleteGear">删除这件装备</button>
    </view>
  </scroll-view>

  <!-- 🔒 下拉联想全屏透明遮罩：脱离 scroll-view，position:fixed 可靠生效 -->
  <!--    点击遮罩仅关闭下拉，绝对不触发任何查询 -->
  <view wx:if="{{suggestionMaskVisible}}" class="suggestion-mask" catchtap="hideAllSuggestions"></view>
</view>
