/**
 * TrailReady 步履无忧 — 页面样式（日系山野小清新 · rpx 响应式）
 */

/* ================================================================ */
/*  容器 & 布局                                                      */
/* ================================================================ */
.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--bg-primary);
  overflow: hidden;
}

.tab-scroll {
  flex: 1;
  height: 0;
}

.section-gap {
  padding: 20rpx 24rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ================================================================ */
/*  标签栏                                                           */
/* ================================================================ */
.tab-bar {
  display: flex;
  flex-shrink: 0;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-subtle);
  padding: 8rpx 16rpx;
  gap: 8rpx;
  backdrop-filter: blur(20rpx);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 20rpx;
  transition: all 0.2s;
  position: relative;
  font-weight: 500;
}

.tab:active {
  background: var(--bg-item);
}

.tab-active {
  color: var(--text-accent);
  font-weight: 700;
  background: var(--accent-bg);
}

.tab-count {
  display: inline-block;
  margin-left: 8rpx;
  background: var(--border-accent);
  color: var(--text-accent);
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-weight: 600;
  vertical-align: middle;
}

/* ================================================================ */
/*  卡片头部                                                         */
/* ================================================================ */
.card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.card-head-icon {
  font-size: 32rpx;
}

.card-head-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

/* 行程表单沿用总览页的 trail-screen、trail-card 和 trail-primary。 */
.trail-editor {
  --edit-fill: #f3f7f3;
  --edit-border: #dce6df;
  --edit-accent: #12644e;
  --edit-hint: #617569;
}
.trail-editor .edit-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.edit-card > .section-title, .edit-card > .trail-heading {
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--edit-border);
}
.edit-line, .edit-picker, .edit-duration, .edit-stays, .edit-forecast {
  display: flex;
  align-items: center;
}
.edit-line { gap: 16rpx; }
.edit-label { width: 122rpx; flex: none; font-size: 27rpx; font-weight: 550; }
.edit-value, .edit-line > .edit-input { flex: 1; min-width: 0; }
.edit-input, .edit-picker {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  padding: 0 18rpx;
  background: var(--edit-fill);
  border: 1rpx solid var(--edit-border);
  border-radius: 14rpx;
  font-size: 28rpx;
  color: inherit;
}
.edit-placeholder, .edit-chevron { color: var(--edit-hint); }
.edit-picker { justify-content: space-between; gap: 12rpx; }
.edit-duration, .edit-stays {
  background: var(--edit-fill);
  border: 1rpx solid var(--edit-border);
  border-radius: 16rpx;
}
.edit-duration { color: var(--edit-accent); font-size: 26rpx; }
.edit-duration button, .edit-stays button { min-height: 76rpx; text-align: center; }
.edit-duration button { width: 72rpx; font-size: 34rpx; }
.edit-duration button[disabled] { opacity: .38; }
.duration-input { width: 50rpx; text-align: center; font-weight: 600; }
.edit-stays { flex: 1; min-width: 0; padding: 4rpx; }
.edit-stays button { flex: 1; min-width: 0; min-height: 68rpx; font-size: 26rpx; }
.edit-stays .selected { background: var(--edit-accent); color: #fff; border-radius: 12rpx; }
.edit-forecast { flex-wrap: wrap; gap: 10rpx; font-size: 25rpx; }
.trail-editor .dest-wrap { position: relative; z-index: 100; }
.trail-editor .suggestions-dropdown {
  background: #fff; border-color: var(--edit-border); box-shadow: 0 8rpx 24rpx rgba(26,58,43,.1);
}
.trail-editor .suggestion-name { color: inherit; }
.trail-editor .suggestion-address, .trail-editor .suggestion-no-result { color: var(--edit-hint); }

.editor-dark {
  --edit-fill: var(--bg-input);
  --edit-border: var(--border-mid);
  --edit-hint: var(--text-secondary);
  --edit-accent: #18745c;
  background: var(--bg-primary);
  color: var(--text-primary);
}
.editor-dark .trail-card, .editor-dark .suggestions-dropdown { background: var(--bg-secondary); border-color: var(--edit-border); }
.editor-dark .trail-meta, .editor-dark .edit-duration { color: var(--text-secondary); }

/* ================================================================ */
/*  智能宿营看板                                                     */
/* ================================================================ */
.smart-board {
  background: linear-gradient(135deg, var(--accent-bg), var(--accent-bg));
  border: 1rpx solid var(--border-accent);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.smart-board text {
  font-size: 24rpx;
  color: var(--text-accent);
  line-height: 1.6;
}

/* ================================================================ */
/*  住宿模式                                                         */
/* ================================================================ */
.lodge-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.lodge-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--border-subtle);
  background: var(--bg-card-hover);
  transition: all 0.2s;
}

.lodge-btn:active {
  background: var(--bg-input);
}

.lodge-btn-hotel {
  border-color: var(--border-active);
  background: var(--accent-bg);
  box-shadow: 0 0 20rpx var(--accent-bg);
}

.lodge-btn-camp {
  border-color: var(--border-active);
  background: var(--accent-bg);
  box-shadow: 0 0 20rpx var(--accent-bg);
}

.lodge-icon {
  font-size: 44rpx;
}

.lodge-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.lodge-desc {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.lodge-hint {
  font-size: 22rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  line-height: 1.6;
}

.lodge-hint-hotel {
  background: var(--accent-bg);
  border: 1rpx solid var(--accent-bg-deep);
  color: var(--text-accent-light);
}

.lodge-hint-camp {
  background: var(--accent-bg);
  border: 1rpx solid var(--accent-bg-deep);
  color: var(--text-accent-light);
}

/* ─── 联想下拉透明遮罩（阻断误触）─── */
.suggestion-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 98;
  background: transparent;
}

/* ─── 城市联想下拉浮层 ─── */
.suggestions-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  z-index: 999;
  max-height: 400rpx;
  overflow-y: auto;
  background: var(--bg-card);
  backdrop-filter: blur(30rpx);
  border: 1rpx solid var(--border-mid);
  border-top: 1rpx solid var(--border-accent);
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 16rpx 40rpx var(--accent-bg-deep);
  animation: suggestSlideIn 0.15s ease-out;
  margin-top: 2rpx;
}

@keyframes suggestSlideIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.suggestions-loading {
  padding: 24rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.suggestion-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-divider);
  transition: background 0.1s;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-item:active {
  background: var(--accent-bg-deep);
}

.suggestion-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.suggestion-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.suggestion-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggestion-address {
  font-size: 20rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 2rpx;
}

.suggestion-admin {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggestion-no-result {
  padding: 32rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ================================================================ */
/*  装备库                                                           */
/* ================================================================ */
.gear-add-btn {
  background: var(--accent);
  color: var(--text-on-primary);
  font-weight: 700;
  font-size: 28rpx;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx var(--border-accent);
  transition: all 0.15s;
}

.gear-add-btn:active {
  background: var(--accent-dark);
  transform: scale(0.98);
}

/* 空状态 */
.gear-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.gear-empty-icon {
  font-size: 80rpx;
}

.gear-empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.gear-empty-sub {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 分组 */
.gear-group {
  margin-bottom: 4rpx;
}

.gear-cat-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 8rpx;
}

.gear-cat-head:active {
  background: var(--bg-card-hover);
  border-radius: 20rpx;
}

.gear-cat-icon {
  font-size: 28rpx;
}

.gear-cat-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.gear-cat-meta {
  font-size: 22rpx;
  color: var(--text-muted);
  flex: 1;
}

.gear-cat-arrow {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 装备项 */
.gear-items {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gear-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-item);
  border: 1rpx solid var(--border-divider);
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  transition: all 0.15s;
}

.gear-item:active {
  background: var(--bg-card-hover);
}

.gear-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gear-item-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gear-item-tags {
  display: flex;
  gap: 6rpx;
  flex-wrap: wrap;
}

/* 标签通用样式 */
.tag-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: var(--accent-bg-deep);
  color: var(--text-accent-light);
  border: 1rpx solid var(--border-accent);
  margin-right: 4rpx;
}

.gear-item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.gear-item-weight {
  font-size: 24rpx;
  color: var(--text-accent);
  font-family: 'Menlo', 'Courier New', monospace;
  font-weight: 600;
}

.gear-item-actions {
  display: flex;
  gap: 4rpx;
}

.gear-action-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 24rpx;
  transition: all 0.15s;
}

.gear-action-edit:active {
  background: var(--border-input);
}

.gear-action-del:active {
  background: var(--red-bg);
}

/* 底部统计 */
.gear-footer {
  text-align: center;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--border-divider);
  margin-top: 8rpx;
}

.gear-footer text {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ================================================================ */
/*  打包清单                                                         */
/* ================================================================ */
.packing-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
  gap: 20rpx;
  text-align: center;
}

.packing-empty-icon {
  font-size: 80rpx;
}

.packing-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.packing-empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
  max-width: 480rpx;
}

/* 摘要行 */
.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.summary-row + .summary-row {
  border-top: 1rpx solid var(--border-divider);
}

.summary-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.summary-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 仪表盘 */
.dashboard-grid {
  display: flex;
  gap: 16rpx;
}

.dash-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 16rpx;
  border-radius: 20rpx;
  background: var(--bg-card-hover);
  border: 1rpx solid var(--border-divider);
}

.dash-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  font-family: 'Menlo', 'Courier New', monospace;
}

.dash-num.accent {
  color: var(--text-accent);
}

.dash-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 气候挑战 */
.climate-card {
  border-color: var(--blue-bg);
}

.climate-item {
  font-size: 24rpx;
  color: var(--text-link);
  padding: 12rpx 0;
  line-height: 1.5;
}

.climate-item + .climate-item {
  border-top: 1rpx solid var(--blue-bg);
}

/* 警告 */
.warnings-card {
  background: var(--warning-bg);
  border: 1rpx solid var(--warning-border);
  border-radius: 24rpx;
  padding: 28rpx;
}

.warnings-card .card-head-label {
  color: var(--text-primary);
}

.warning-item {
  font-size: 24rpx;
  color: var(--text-primary);
  padding: 12rpx 0;
  line-height: 1.5;
}

.warning-item + .warning-item {
  border-top: 1rpx solid var(--warning-divider);
}

/* 提示 */
.info-card {
  border-color: var(--accent-bg-deep);
}

.info-item {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
  line-height: 1.5;
}

.info-item + .info-item {
  border-top: 1rpx solid var(--accent-bg);
}

/* 进度条 */
.progress-wrap {
  padding: 8rpx 0;
}

.progress-bar {
  height: 10rpx;
  background: var(--bg-input);
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: var(--progress-fill);
  border-radius: 14rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* 打包分组 */
.pack-group {
  margin-bottom: 4rpx;
}

.pack-cat-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 8rpx;
}

.pack-cat-head:active {
  background: var(--bg-card-hover);
  border-radius: 20rpx;
}

.pack-cat-icon {
  font-size: 28rpx;
}

.pack-cat-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.pack-cat-meta {
  font-size: 22rpx;
  color: var(--text-muted);
  flex: 1;
}

/* 打包项 */
.pack-items {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.pack-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--bg-card-hover);
  border: 1rpx solid var(--border-divider);
  border-radius: 20rpx;
  padding: 18rpx 16rpx;
  transition: all 0.15s;
}

.pack-item:active {
  background: var(--bg-input);
}

.pack-item-done {
  opacity: 0.45;
}

/* 勾选框 */
.pack-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 2rpx solid var(--border-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-on-primary);
  transition: all 0.15s;
}

.pack-check-on {
  background: var(--accent);
  border-color: var(--text-accent);
}

.pack-check:active {
  border-color: var(--text-accent);
}

/* 打包项信息 */
.pack-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pack-item-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.strikethrough {
  text-decoration: line-through;
  color: var(--text-secondary);
}

.pack-item-qty {
  font-size: 22rpx;
  color: var(--text-accent-light);
  font-weight: 700;
}

.pack-item-reason {
  font-size: 20rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.pack-item-wt {
  font-size: 24rpx;
  color: var(--text-accent);
  font-family: 'Menlo', 'Courier New', monospace;
  font-weight: 600;
  flex-shrink: 0;
}

/* 装备表单与行程编辑共用卡片及字段样式。 */
.gear-weight-field { position: relative; }
.gear-weight-field .edit-input { padding-right: 54rpx; }
.gear-unit {
  position: absolute; right: 18rpx; top: 50%; transform: translateY(-50%);
  color: var(--edit-hint); font-size: 26rpx; pointer-events: none;
}
.gear-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.trail-editor .gear-tag {
  min-height: 64rpx; padding: 10rpx 20rpx; box-sizing: border-box;
  border: 1rpx solid var(--edit-border); border-radius: 14rpx;
  background: var(--edit-fill); color: #315746; font-size: 26rpx; text-align: center;
}
.trail-editor .gear-tag.selected { background: var(--edit-accent); border-color: var(--edit-accent); color: #fff; }
.gear-error, .trail-editor .gear-remove { color: #a43b38; font-size: 26rpx; }
.gear-form-actions { display: flex; gap: 16rpx; }
.gear-form-actions .trail-primary { flex: 2; }
.trail-editor .gear-cancel {
  flex: 1; padding: 20rpx; border-radius: 16rpx; border: 1rpx solid var(--edit-border);
  color: var(--edit-accent); background: #fff; text-align: center;
}
.trail-editor .gear-remove { align-self: center; padding: 12rpx 20rpx; }
